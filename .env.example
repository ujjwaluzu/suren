# Public URL. Set the real owned URL at build time for metadata and origin validation.
# Planned production URL after domain purchase and setup: https://surencompany.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public contact, verified by the operator. Empty hides the email link.
NEXT_PUBLIC_CONTACT_EMAIL=
# Local mode only works on loopback and never contacts live providers.
ENQUIRY_MODE=local
# Live enquiries require all of these. Service role must never be NEXT_PUBLIC.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_SALT=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=
# Optional. GA is loaded only after opt-in.
NEXT_PUBLIC_GA_ID=
# Optional server-side error reporting; no form payload is attached.
SENTRY_DSN=
# Optional HubSpot contact upsert.
HUBSPOT_ACCESS_TOKEN=
